#!/usr/bin/env bash
# Fast checks on staged changes; the full suite runs in CI (`make check`).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if grep -qE '^(core/|Cargo\.)' <<<"$staged"; then
  cargo fmt --all --check
  cargo clippy --workspace --all-targets --quiet -- -D warnings
fi
if grep -qE '^sym/' <<<"$staged"; then
  (cd "$root/sym" && uv run --quiet ruff format --check . && uv run --quiet ruff check . && uv run --quiet meowfer-derive --check)
fi
if grep -qE '^web/' <<<"$staged"; then
  (cd "$root/web" && npx --no -- biome ci . >/dev/null && npx --no -- tsc --noEmit)
fi
